  "text": [
    {
      "sprecher": "甲",
      "zh": "學校有很多外國學生，是嗎？",
      "pinyin": "xué  xiào   yǒu   hěn   duō   wài  guó   xué  shēng        shì    ma",
      "de": "In der Schule gibt es viele ausländische Schüler, nicht wahr?",
      "audio": "audio/08-01.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "是啊，有很多。",
      "pinyin": "shì     a          yǒu   hěn  duō",
      "de": "Ja, sehr viele.",
      "audio": "audio/08-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "比本國學生還多嗎？",
      "pinyin": "bǐ     běn   guó   xué  shēng  hái   duō   ma",
      "de": "Noch mehr als Einheimische?",
      "audio": "audio/08-03.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "不，比本國學生少。",
      "pinyin": "bù           bǐ     běn   guó   xué  shēng  shǎo",
      "de": "Nein, weniger als Einheimische.",
      "audio": "audio/08-04.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "男生跟女生一樣多嗎？",
      "pinyin": "nán  shēng  gēn    nyǔ  shēng   yí    yàng   duō   ma",
      "de": "Gibt es genauso viele Schüler wie Schülerinnen?",
      "audio": "audio/08-05.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "差不多一樣多。",
      "pinyin": "chà   bù   duō     yí  yàng  duō",
      "de": "Fast genauso viel.",
      "audio": "audio/08-06.mp3"
    }
  ],
