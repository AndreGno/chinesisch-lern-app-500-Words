  "text": [
    {
      "sprecher": "甲",
      "zh": "你到這裡來學中文嗎？",
      "pinyin": "nǐ    dào   zhè     lǐ     lái    xué  zhōng wén   ma",
      "de": "Kommst du hierher, um Chinesisch zu lernen?",
      "audio": "audio/05-01.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "是的，我來學中文。",
      "pinyin": "shì     de           wǒ    lái    xué  zhōng  wén",
      "de": "Ja, ich komme, um Chinesisch zu lernen.",
      "audio": "audio/05-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "那麼我們是同學。",
      "pinyin": "nà     me    wǒ   men   shì   tóng   xué",
      "de": "Dann sind wir Schulkameraden.",
      "audio": "audio/05-03.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "誰是我們的老師？",
      "pinyin": "shéi   shì    wǒ  men   de    lǎo   shī",
      "de": "Wer ist unser Lehrer?",
      "audio": "audio/05-04.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "李先生是我們的老師。",
      "pinyin": "Lǐ   xiān  shēng  shì    wǒ   men   de    lǎo   shī",
      "de": "Herr Li ist unser Lehrer.",
      "audio": "audio/05-05.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "他是華人嗎？",
      "pinyin": "tā     shì     huá   rén    ma",
      "de": "Ist er Chinese?",
      "audio": "audio/05-06.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "他是華人，他會說中文",
      "pinyin": "tā     shì     huá    rén            tā      hùi  shuō  zhōng  wén",
      "de": "也會寫中文。",
      "audio": "audio/05-07.mp3"
    }
  ],
