  "wiederholung": [
    {
      "sprecher": "甲",
      "zh": "你一個人住在外面，一定有很多地方不方便。"
    },
    {
      "sprecher": "乙",
      "zh": "是的，我很想家，所以我週末常回去。"
    },
    {
      "sprecher": "甲",
      "zh": "這個週末你到我家來玩兩天吧！"
    },
    {
      "sprecher": "乙",
      "zh": "會不會太麻煩你們？"
    },
    {
      "sprecher": "甲",
      "zh": "不會的，你不要客氣，我父母親很歡迎客人。"
    },
    {
      "sprecher": "乙",
      "zh": "住在你家方便嗎？"
    },
    {
      "sprecher": "甲",
      "zh": "非常方便，我家有好幾間臥房，客廳、飯廳也不"
    },
    {
      "sprecher": "乙",
      "zh": "太好了，我很喜歡打球。"
    },
    {
      "sprecher": "甲",
      "zh": "那麼週末我來接你。"
    },
    {
      "sprecher": "乙",
      "zh": "不用了，只要給我地址，我一定找得到。"
    }
