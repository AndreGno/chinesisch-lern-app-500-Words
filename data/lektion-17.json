  "wiederholung": [
    {
      "sprecher": "甲",
      "zh": "請問，毛筆一枝多少錢？"
    },
    {
      "sprecher": "乙",
      "zh": "這種筆一枝五百塊。"
    },
    {
      "sprecher": "甲",
      "zh": "五百塊？太貴了。"
    },
    {
      "sprecher": "乙",
      "zh": "我們也有便宜的。"
    },
    {
      "sprecher": "甲",
      "zh": "便宜的好寫嗎？"
    },
    {
      "sprecher": "乙",
      "zh": "便宜的也好寫，只是不好看。"
    },
    {
      "sprecher": "甲",
      "zh": "不好看沒關係。多少錢一枝？"
    },
    {
      "sprecher": "乙",
      "zh": "一百五十塊一枝。"
    },
    {
      "sprecher": "甲",
      "zh": "那麼我買兩枝。"
    },
    {
      "sprecher": "乙",
      "zh": "兩枝一共三百塊錢。"
    },
    {
      "sprecher": "甲",
      "zh": "這是五百塊。"
    },
    {
      "sprecher": "乙",
      "zh": "你有沒有零錢？"
    },
    {
      "sprecher": "甲",
      "zh": "對不起，我沒有。"
    },
    {
      "sprecher": "乙",
      "zh": "沒關係，我可以換開。好了，找你兩百塊，謝謝。"
    }
  ],
  "anwendung": [
    {
      "sprecher": "甲",
      "zh": "你買了些什麼？",
      "pinyin": "nǐ    mǎi    le    xiē    shé   me",
      "de": "Was hast du gekauft?"
    },
    {
      "sprecher": "乙",
      "zh": "我買了一些文具。",
      "pinyin": "wǒ   mǎi    le      yì    xiē   wén   jù",
      "de": "Ich habe einige Schreibwaren gekauft."
    },
    {
      "sprecher": "甲",
      "zh": "你在那裡買的？",
      "pinyin": "nǐ     zài    nǎ     lǐ     mǎi   de",
      "de": "Wo hast du sie gekauft?"
    },
    {
      "sprecher": "乙",
      "zh": "我在百貨公司買的。",
      "pinyin": "wǒ    zài    bǎi  huò  gōng   sī    mǎi    de",
      "de": "Ich habe sie im Kaufhaus gekauft."
    },
    {
      "sprecher": "甲",
      "zh": "百貨公司的東西貴不貴？",
      "pinyin": "bǎi   huò  gōng   sī     de   dōng   xi    gùi    bú   gùi",
      "de": "Sind die Sachen im Kaufhaus teuer?"
    },
    {
      "sprecher": "乙",
      "zh": "不一定，有的貴，有的便宜。",
      "pinyin": "bù     yí   dìng        yǒu   de    gùi        yǒu   de    pián   yí",
      "de": "Nicht unbedingt. Manche sind teuer, manche billig."
    },
    {
      "sprecher": "甲",
      "zh": "你一共用了多少錢？",
      "pinyin": "nǐ     yí    gòng  yòng   le    duō  shǎo  qián",
      "de": "Wie viel hast du insgesamt ausgegeben?"
    },
    {
      "sprecher": "乙",
      "zh": "一共用了三百二十塊。",
      "pinyin": "yí  gòng  yòng   le     sān    bǎi     èr     shí   kuài",
      "de": "Ich habe insgesamt 320 NT$ ausgegeben."
    },
    {
      "sprecher": "甲",
      "zh": "你準備零錢了嗎？",
      "pinyin": "nǐ   zhǔn  bèi   líng  qián    le    ma",
      "de": "Hast du Kleingeld vorbereitet?"
    },
    {
      "sprecher": "乙",
      "zh": "沒有，我給他們五百塊，他們找我錢。",
      "pinyin": "méi  yǒu         wǒ   gěi     tā    men  wǔ   bǎi   kuài         tā    men  zhǎo  wǒ  qián",
      "de": "Nein, ich gab ihnen 500 NT$. Sie haben mir herausgegeben."
    },
    {
      "sprecher": "甲",
      "zh": "他們找了多少？",
      "pinyin": "tā    men  zhǎo   le   duō  shǎo",
      "de": "Wie viel haben sie herausgegeben?"
    },
    {
      "sprecher": "乙",
      "zh": "你說呢？",
      "pinyin": "nǐ   shuō   ne",
      "de": "Was glaubst du?"
    }
  ]
}