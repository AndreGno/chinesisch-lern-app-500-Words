      "zh": "錢",
      "zhuyin": "ㄑㄧㄢˊ",
      "pinyin": "qián",
      "de": "das Geld"
    }
  ],
  "wiederholung": [
    {
      "sprecher": "甲",
      "zh": "請問，毛筆一枝多少錢？"
    },
    {
      "sprecher": "乙",
      "zh": "這種筆一枝五百塊。"
    },
    {
      "sprecher": "甲",
      "zh": "五百塊？太貴了。"
    },
    {
      "sprecher": "乙",
      "zh": "我們也有便宜的。"
    },
    {
      "sprecher": "甲",
      "zh": "便宜的好寫嗎？"
    },
    {
      "sprecher": "乙",
      "zh": "便宜的也好寫，只是不好看。"
    },
    {
      "sprecher": "甲",
      "zh": "不好看沒關係。多少錢一枝？"
    },
    {
      "sprecher": "乙",
      "zh": "一百五十塊一枝。"
    },
    {
      "sprecher": "甲",
      "zh": "那麼我買兩枝。"
    },
    {
      "sprecher": "乙",
      "zh": "兩枝一共三百塊錢。"
    },
    {
      "sprecher": "甲",
      "zh": "這是五百塊。"
    },
    {
      "sprecher": "乙",
      "zh": "你有沒有零錢？"
    },
    {
      "sprecher": "甲",
      "zh": "對不起，我沒有。"
    },
    {
      "sprecher": "乙",
      "zh": "沒關係，我可以換開。好了，找你兩百塊，謝謝。"
    }
  ],
