{
  "nummer": 17,
  "text": [
    {
      "sprecher": "甲",
      "zh": "請問，毛筆一枝多少錢？",
      "pinyin": "qǐng  wèn        máo   bǐ     yì    zhī   duō   shǎo  qián",
      "de": "Wie viel kostet bitte ein Pinsel?",
      "audio": "audio/17-01.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "這種筆一枝五百塊。",
      "pinyin": "zhè  zhǒng  bǐ     yì     zhī    wǔ    bǎi   kuài",
      "de": "Solche Pinsel kosten pro Stück 500 NT$.",
      "audio": "audio/17-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "五百塊？太貴了。",
      "pinyin": "wǔ    bǎi   kuài        tài    gùi     le",
      "de": "500 NT$? Das ist zu teuer.",
      "audio": "audio/17-03.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "我們也有便宜的。",
      "pinyin": "wǒ   men   yě   yǒu   pián   yí     de",
      "de": "Wir haben auch billigere.",
      "audio": "audio/17-04.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "便宜的好寫嗎？",
      "pinyin": "pián   yí    de     hǎo  xiě    ma",
      "de": "Schreiben die billigeren Pinsel gut?",
      "audio": "audio/17-05.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "便宜的也好寫，只是不好看。",
      "pinyin": "pián   yí     de     yě   hǎo   xiě         zhǐ    shì    bù    hǎo  kàn",
      "de": "Die Billigeren schreiben auch gut. Sie sehen nur nicht so schön aus.",
      "audio": "audio/17-06.mp3"
    }
  ],
