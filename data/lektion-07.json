    {
      "sprecher": "甲",
      "zh": "這所學校有多少學生？",
      "pinyin": "zhè  suǒ   xué  xiào  yǒu  duō  shǎo  xué  shēng",
      "de": "Wie viele Schüler hat diese Schule?",
      "audio": "audio/07-01.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "有兩千五百多個學生。",
      "pinyin": "yǒu  liǎng  qiān  wǔ     bǎi   duō    ge    xué  shēng",
      "de": "Es sind über 2,500 Schüler.",
      "audio": "audio/07-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "這所學校真不小。",
      "pinyin": "szhè suǒ  xué  xiào  zhēn   bù   xiǎo",
      "de": "Diese Schule ist wirklich ziemlich groß.",
      "audio": "audio/07-03.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "是啊，這是所大學校。",
      "pinyin": "shì      a           zhè  shì    suǒ    dà   xué  xiào",
      "de": "Ja, das ist eine große Schule.",
      "audio": "audio/07-04.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "學校裡有沒有外國學生？",
      "pinyin": "xué   xiào   lǐ    yǒu   méi  yǒu   wài  guó  xué  shēng",
      "de": "Gibt es ausländische Schüler in der Schule?",
      "audio": "audio/07-05.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "外國學生很多。",
      "pinyin": "wài  guó  xué  shēng  hěn  duō",
      "de": "Es gibt viele ausländische Schüler.",
      "audio": "audio/07-06.mp3"
    }
