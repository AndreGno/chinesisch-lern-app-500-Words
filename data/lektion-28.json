    },
    {
      "sprecher": "乙",
      "zh": "你想買什麼？",
      "pinyin": "nǐ  xiǎng  mǎi   shé   me",
      "de": "Was möchtest du kaufen?",
      "audio": "audio/28-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "我想買一雙鞋子，兩雙襪子。",
      "pinyin": "wǒ   xiǎng  mǎi    yì  shuāng  xié      zi         liǎng  shuāng  wà     zi",
