{
  "nummer": 4,
  "text": [
    {
      "sprecher": "甲",
      "zh": "你到那裡去？",
      "pinyin": "nǐ    dào    nǎ     lǐ     qù",
      "de": "Wohin gehst du?",
      "audio": "audio/04-01.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "我到學校去。",
      "pinyin": "wǒ   dào  xué   xiào   qù",
      "de": "Ich gehe zur Schule.",
      "audio": "audio/04-02.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "你去做什麼？",
      "pinyin": "nǐ     qù    zuò  shé    me",
      "de": "Warum gehst du dorthin?",
      "audio": "audio/04-03.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "我去學中文。",
      "pinyin": "wǒ     qù     xué   zhōng   wén",
      "de": "Ich gehe dorthin, um Chinesisch zu lernen.",
      "audio": "audio/04-04.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "李先生也去學中文嗎？",
      "pinyin": "Lǐ   xiān  shēng  yě     qù    xué  zhōng  wén  ma",
      "de": "Geht Herr Li auch dorthin, um Chinesisch zu lernen?",
      "audio": "audio/04-05.mp3"
    },
    {
      "sprecher": "乙",
      "zh": "不，他去教中文。",
      "pinyin": "bù            tā       qù     jiāo  zhōng  wén",
      "de": "Nein, er unterrichtet Chinesisch.",
      "audio": "audio/04-06.mp3"
    },
    {
      "sprecher": "甲",
      "zh": "那麼，他是老師，我們是學生。",
      "pinyin": "nà    me           tā    shì    lǎo   shī         wǒ   men   shì  xué  shēng",
      "de": "Dann ist er Lehrer, und wir sind Schüler.",
      "audio": "audio/04-07.mp3"
    }
  ],
